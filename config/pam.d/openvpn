# /etc/pam.d/openvpn
#
# PAM stack for SouthVPN OpenVPN authentication.
# Requires: correct Linux password AND a valid Google Authenticator TOTP code.
#
# Authentication flow:
#   OpenVPN receives combined credential "password\nOTP" (via static-challenge).
#   pam_unix.so validates the password portion against /etc/shadow.
#   pam_google_authenticator.so validates the OTP portion from the per-user
#   secret file, reading it as 'nobody' (the UID OpenVPN drops to after startup).
#
# Security notes:
#   - 'nodelay' removes the 2-second failure penalty (TOTP is a second factor).
#   - 'forward_pass' reads OTP from the remainder after '\n'; no second prompt.
#   - 'user=nobody' ensures the secret file is read as the OpenVPN process UID.
#   - No 'nullok': users without a .google_authenticator file are always denied.

auth    required    pam_unix.so    nodelay
auth    required    pam_google_authenticator.so \
                        secret=/etc/openvpn/server/auth/${USER}/.google_authenticator \
                        user=nobody \
                        forward_pass
account required    pam_unix.so
